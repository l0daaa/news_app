    {
      "parameters": {
        "promptType": "define",
        "text": "=User question:\n{{ $('Webhook').item.json.body.message }}\n\nNews articles (JSON array):\n{{ JSON.stringify($json.articles) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a News AI Assistant for a mobile news app. You are given a user question and a JSON array of English news articles. Find the single most relevant article to the user question and summarize it.\n\nRules:\n- Use ONLY information contained in the provided articles. Do not invent any facts.\n- Keep the summary short and clear.\n- Answer in the same language as the user question (write \"title\" and \"summary\" in that language).\n- Include the title, source, date, and URL of the chosen article.\n- If a relevant article is found, set \"found\" to true and fill title, summary, source (source name), date (publishedAt), and url from that article.\n- If no relevant article is found, or the articles array is empty, return {\"found\": false, \"title\": \"\", \"summary\": \"\", \"source\": \"\", \"date\": \"\", \"url\": \"\"}."
        }
      },
      "id": "2322d1b8-9973-443f-a5f0-e3b9531c6177",
